// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Gender {
  male
  female
  other
  prefer_not_to_say
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  username            String?   @unique
  avatar_url          String?
  password_hash       String?
  provider            String    @default("local")
  provider_id         String?
  mfa_enabled         Boolean   @default(false)
  plan_type           String    @default("free")
  gender              Gender?
  birth_day           DateTime?
  role                String    @default("user")
  reset_token_hash    String?
  onboarding_completed Boolean  @default(false)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?
  notifications_enabled     Boolean   @default(true)
  reminder_start_hour       Int       @default(8)  
  reminder_end_hour         Int       @default(21)

  sessions Session[]
  rooms Room[]
  user_plants UserPlant[]
}

model Session {
  id                 String    @id @default(uuid())
  user_id            String
  token_hash         String    @unique
  expires_at         DateTime
  revoked_at         DateTime?
  created_at         DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id])
}

enum LightLevel {
  low
  medium
  high
}

model Room {
  id         String     @id @default(uuid())
  user_id    String
  name       String
  size_m2    Decimal?
  light_level LightLevel?
  created_at DateTime   @default(now())
  deleted_at DateTime?

  user User @relation(fields: [user_id], references: [id])
}

enum PlantCategory {
  tropical
  succulent
  cactus
  fern
  flowering
  herb
  tree
  other
}

enum LightRequirement {
  low
  medium
  high
  indirect
}

enum HumidityPreference {
  low
  medium
  high
}

enum HealthStatus {
  excellent
  good
  fair
  poor
  critical
}

model PlantSpecies {
  id                   String   @id @default(uuid())
  scientific_name      String   @unique
  common_name          String
  category             PlantCategory
  light_requirement    LightRequirement
  water_frequency_days Int
  humidity_preference  HumidityPreference
  air_purification_score Int    @default(0)
  min_temperature      Int
  max_temperature      Int
  created_at           DateTime @default(now())

  user_plants UserPlant[]
}

model UserPlant {
  id            String       @id @default(uuid())
  user_id       String
  species_id    String
  nickname      String?
  health_status HealthStatus @default(good)
  acquired_at   DateTime     @default(now())
  last_watered_at DateTime?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  deleted_at    DateTime?

  user    User         @relation(fields: [user_id], references: [id])
  species PlantSpecies @relation(fields: [species_id], references: [id])
}